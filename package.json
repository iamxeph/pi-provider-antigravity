{
  "name": "pi-provider-antigravity",
  "version": "0.3.0",
  "description": "Minimal Antigravity provider for Pi Coding Agent",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iamxeph/pi-provider-antigravity.git"
  },
  "bugs": {
    "url": "https://github.com/iamxeph/pi-provider-antigravity/issues"
  },
  "homepage": "https://github.com/iamxeph/pi-provider-antigravity#readme",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "keywords": [
    "pi-package",
    "pi-extension",
    "antigravity",
    "google",
    "oauth",
    "provider"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "sanitize:captures": "node scripts/sanitize-captures.mjs",
    "lint:captures": "node scripts/lint-captures.mjs",
    "test": "npm run lint:captures && node --experimental-strip-types --test 'tests/**/*.test.mjs' 'tests/**/*.test.ts'",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.80.0",
    "@earendil-works/pi-coding-agent": ">=0.80.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.85.0",
    "@earendil-works/pi-coding-agent": "^0.85.0",
    "@types/node": "^26.4.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
